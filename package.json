{
  "name": "fintrack-stark",
  "version": "1.0.0",
  "private": true,
  "description": "FinTrack Stark - Personal Finance, Bill Reminder, and Payment Tracking Integration System",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "seed": "node server/seed.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently -n API,WEB -c blue,magenta \"npm:server\" \"npm:client\"",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
